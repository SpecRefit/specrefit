{
  "name": "specrefit",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Local OpenAPI contract inspection",
  "license": "Apache-2.0",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "desktop": "electron .",
    "test": "node --test tests/engine.test.ts tests/transform.test.ts tests/contract-media.test.ts tests/bundle.test.ts tests/export.test.ts tests/export-filesystem.test.mjs tests/desktop-import.test.mjs",
    "test:version": "node --test tests/version.test.mjs",
    "test:development": "node --test tests/development.test.mjs",
    "archive:development": "node scripts/archive-development.mjs",
    "test:browser": "playwright test",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop-archive": "node scripts/test-desktop-archive.mjs",
    "test:packaging": "node --test tests/packaging.test.mjs",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
